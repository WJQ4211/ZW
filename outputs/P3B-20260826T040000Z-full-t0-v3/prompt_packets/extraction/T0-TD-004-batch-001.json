    {
      "source_id": "T0-TD-004",
      "source_locator": "web_paragraph_0005",
      "text": "Home News ACE Program Achieves World First For AI In Aerospace",
      "pdf_page_number": null,
      "printed_page_number": null,
      "section_title": "web_body",
